config STM32N6_STM32N6XXXX
	bool
	default y

choice
	prompt "STM32 N6 Chip Selection"
	default ARCH_CHIP_STM32N657X0

config ARCH_CHIP_STM32N657X0
	bool "STM32N657X0"
	select STM32N6_STM32N6XXXX
	select ARMV8M_HAVE_ICACHE
	select ARMV8M_HAVE_DCACHE

endchoice

menu "STM32N6 Peripheral Selection"

config STM32N6_USART1
	bool "USART1"
	default n
	select STM32N6_USART
	select USART1_SERIALDRIVER
	select STM32N6_USART1_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config STM32N6_USART1_SERIALDRIVER
	bool
	default n

config STM32N6_USART2
	bool "USART2"
	default n
	select STM32N6_USART
	select USART2_SERIALDRIVER
	select STM32N6_USART2_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config STM32N6_USART2_SERIALDRIVER
	bool
	default n

config STM32N6_USART3
	bool "USART3"
	default n
	select STM32N6_USART
	select USART3_SERIALDRIVER
	select STM32N6_USART3_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config STM32N6_USART3_SERIALDRIVER
	bool
	default n

config STM32N6_UART4
	bool "UART4"
	default n
	select STM32N6_USART
	select UART4_SERIALDRIVER
	select STM32N6_UART4_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config STM32N6_UART4_SERIALDRIVER
	bool
	default n

config STM32N6_UART5
	bool "UART5"
	default n
	select STM32N6_USART
	select UART5_SERIALDRIVER
	select STM32N6_UART5_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config STM32N6_UART5_SERIALDRIVER
	bool
	default n

config STM32N6_USART
	bool

config STM32N6_DMA
	bool
	default n

config STM32N6_GPDMA1
	bool "GPDMA1 (General Purpose DMA)"
	default n
	select STM32N6_DMA
	select ARCH_DMA

config STM32N6_HPDMA1
	bool "HPDMA1 (High Performance DMA)"
	default n
	select STM32N6_DMA
	select ARCH_DMA

endmenu
