	bool "ADC2"
	default n
	select STM32N6_ADC
	select ADC
	select ANALOG

config STM32N6_DMA
	bool
	default n

config STM32N6_GPDMA1
	bool "GPDMA1 (General Purpose DMA)"
	default n
	select STM32N6_DMA
	select ARCH_DMA

config STM32N6_HPDMA1
	bool "HPDMA1 (High Performance DMA)"
	default n
	select STM32N6_DMA
	select ARCH_DMA

config STM32N6_USB1_OTG_HS
	bool "USB1 OTG HS"
	default n
	select USBHOST_HAVE_ASYNCH if USBHOST

config STM32N6_USB2_OTG_HS
	bool "USB2 OTG HS"
	default n
	select USBHOST_HAVE_ASYNCH if USBHOST

endmenu

menu "USB OTG Configuration"
	depends on STM32N6_USB1_OTG_HS || STM32N6_USB2_OTG_HS

choice
	prompt "USB1 role"
	depends on STM32N6_USB1_OTG_HS
	default STM32N6_USB1_USBDEV if USBDEV

config STM32N6_USB1_USBDEV
	bool "Device mode"
	depends on USBDEV

config STM32N6_USB1_USBHOST
	bool "Host mode"
	depends on USBHOST

endchoice

choice
	prompt "USB2 role"
	depends on STM32N6_USB2_OTG_HS
	default STM32N6_USB2_USBDEV if USBDEV

config STM32N6_USB2_USBDEV
	bool "Device mode"
	depends on USBDEV

config STM32N6_USB2_USBHOST
	bool "Host mode"
	depends on USBHOST

endchoice

config STM32N6_OTG_VBUS_SENSING
	bool "USB VBUS sensing"
	default n
	---help---
		Enable VBUS sensing via analog comparator.
		If disabled, VBUS valid is overridden in software.

config STM32N6_USBDEV_REGDEBUG
	bool "USB device register debug"
	depends on USBDEV && DEBUG_USB_INFO
	default n

endmenu

menu "PWM Configuration"

config STM32N6_PWM
	bool
	default n

config STM32N6_TIM1_PWM
	bool "TIM1 PWM"
	default n
	depends on STM32N6_TIM1
	select PWM
	select STM32N6_PWM

config STM32N6_TIM1_CHANNEL
	int "TIM1 PWM output channel"
	default 1
	range 1 4
	depends on STM32N6_TIM1_PWM

config STM32N6_TIM1_CHMODE
	int "TIM1 PWM channel mode"
	default 6
	depends on STM32N6_TIM1_PWM

config STM32N6_TIM1_CH1OUT
	bool "TIM1 CH1 output"
	default y
	depends on STM32N6_TIM1_PWM

