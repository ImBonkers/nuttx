	bool "IWDG"
	default n
	select WATCHDOG

config STM32N6_RNG
	bool "RNG"
	default n
	select ARCH_HAVE_RNG

config STM32N6_XSPI
	bool
	default n

config STM32N6_XSPI2
	bool "XSPI2 (external NOR flash)"
	default n
	select STM32N6_XSPI
	---help---
		Enable XSPI2 for external NOR flash (MX25UM51245G 64MB).

config STM32N6_XSPI_INTERRUPTS
	bool "XSPI interrupt mode"
	default n
	depends on STM32N6_XSPI
	---help---
		Use interrupt-driven transfers instead of polling.

config STM32N6_XSPI_FLASH_SIZE
	int "XSPI flash size in bytes"
	default 67108864
	depends on STM32N6_XSPI
	---help---
		Size of the external flash in bytes. Default 64MB.

config STM32N6_XSPI2_DMA
	bool "XSPI2 DMA"
	default n
	depends on STM32N6_XSPI2 && STM32N6_DMA && !STM32N6_XSPI_INTERRUPTS
	---help---
		Use DMA for XSPI2 data transfers. Mutually exclusive with
		interrupt mode. Falls back to polling for small transfers.

config STM32N6_XSPI_DMATHRESHOLD
	int "XSPI DMA threshold"
	default 4
	depends on STM32N6_XSPI2_DMA
	---help---
		Minimum number of bytes for DMA transfer. Transfers smaller
		than this use polling instead.

config STM32N6_NPU
	bool "NPU (Neural-ART accelerator)"
	default n
	---help---
		Enable NPU support. Configures PLL2 (1000 MHz) and PLL3
		(900 MHz) for NPU core and SRAM clocks, and enables the
		NPU peripheral clock on AHB5.

endmenu

menu "RTC Configuration"
	depends on STM32N6_RTC

choice
	prompt "RTC clock source"
	default STM32N6_RTC_LSECLOCK

config STM32N6_RTC_LSECLOCK
	bool "LSE (32.768 kHz)"
	---help---
		Use the LSE crystal as RTC clock source.

config STM32N6_RTC_LSICLOCK
	bool "LSI"
	---help---
		Use the LSI RC oscillator as RTC clock source.

config STM32N6_RTC_HSECLOCK
	bool "HSE/64"
	---help---
		Use the HSE oscillator divided by 64 as RTC clock source.

endchoice

config STM32N6_RTC_MAGIC_REG
	int "RTC magic backup register index"
	default 0
	range 0 31
	---help---
		Backup register used to store the RTC initialization magic value.

endmenu

menu "USB OTG Configuration"
	depends on STM32N6_USB1_OTG_HS || STM32N6_USB2_OTG_HS

choice
	prompt "USB1 role"
	depends on STM32N6_USB1_OTG_HS
	default STM32N6_USB1_USBDEV if USBDEV

config STM32N6_USB1_USBDEV
	bool "Device mode"
	depends on USBDEV

config STM32N6_USB1_USBHOST
	bool "Host mode"
	depends on USBHOST

endchoice

choice
	prompt "USB2 role"
	depends on STM32N6_USB2_OTG_HS
	default STM32N6_USB2_USBDEV if USBDEV

config STM32N6_USB2_USBDEV
	bool "Device mode"
	depends on USBDEV

config STM32N6_USB2_USBHOST
	bool "Host mode"
	depends on USBHOST

endchoice

config STM32N6_OTG_VBUS_SENSING
	bool "USB VBUS sensing"
	default n
	---help---
		Enable VBUS sensing via analog comparator.
		If disabled, VBUS valid is overridden in software.

config STM32N6_USBDEV_REGDEBUG
	bool "USB device register debug"
	depends on USBDEV && DEBUG_USB_INFO
	default n

config STM32N6_OTG_DMA
	bool "USB OTG internal DMA (EXPERIMENTAL)"
	default n
	depends on STM32N6_USB1_OTG_HS || STM32N6_USB2_OTG_HS
	---help---
		Enable the DWC2 internal DMA engine (GAHBCFG.DMAEN).
		Replaces CPU FIFO read/write with hardware scatter-gather
		DMA to/from endpoint buffers. This does NOT use GPDMA or
		HPDMA channels. EXPERIMENTAL: no other NuttX STM32 port
		uses DWC2 internal DMA. Default OFF.

endmenu

