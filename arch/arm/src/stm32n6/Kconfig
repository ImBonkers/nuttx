	bool "SPI1 DMA"
	default n
	depends on STM32N6_SPI1
	select STM32N6_SPI_DMA

config STM32N6_SPI2_DMA
	bool "SPI2 DMA"
	default n
	depends on STM32N6_SPI2
	select STM32N6_SPI_DMA

config STM32N6_SPI3_DMA
	bool "SPI3 DMA"
	default n
	depends on STM32N6_SPI3
	select STM32N6_SPI_DMA

config STM32N6_SPI4_DMA
	bool "SPI4 DMA"
	default n
	depends on STM32N6_SPI4
	select STM32N6_SPI_DMA

config STM32N6_SPI5_DMA
	bool "SPI5 DMA"
	default n
	depends on STM32N6_SPI5
	select STM32N6_SPI_DMA

config STM32N6_SPI6_DMA
	bool "SPI6 DMA"
	default n
	depends on STM32N6_SPI6
	select STM32N6_SPI_DMA

config STM32N6_SPI_DMATHRESHOLD
	int "SPI DMA threshold"
	default 4
	depends on STM32N6_SPI_DMA
	---help---
		Minimum number of bytes for DMA transfer. Transfers smaller
		than this use polling instead.

endmenu

config STM32N6_ADC
	bool
	default n

config STM32N6_ADC1
	bool "ADC1"
	default n
	select STM32N6_ADC
	select ADC
	select ANALOG

config STM32N6_ADC2
	bool "ADC2"
	default n
	select STM32N6_ADC
	select ADC
	select ANALOG

config STM32N6_ADC1_DMA
	bool "ADC1 DMA"
	default n
	depends on STM32N6_ADC1 && STM32N6_DMA
	---help---
		Use DMA one-shot mode for ADC1 multi-channel conversion
		sequences. Reduces CPU overhead during conversions.

config STM32N6_ADC2_DMA
	bool "ADC2 DMA"
	default n
	depends on STM32N6_ADC2 && STM32N6_DMA
	---help---
		Use DMA one-shot mode for ADC2 multi-channel conversion
		sequences. Reduces CPU overhead during conversions.

config STM32N6_DMA
	bool
	default n

config STM32N6_GPDMA1
	bool "GPDMA1 (General Purpose DMA)"
	default n
	select STM32N6_DMA
	select ARCH_DMA

config STM32N6_HPDMA1
	bool "HPDMA1 (High Performance DMA)"
	default n
	select STM32N6_DMA
	select ARCH_DMA

config STM32N6_USB1_OTG_HS
	bool "USB1 OTG HS"
	default n
	select USBHOST_HAVE_ASYNCH if USBHOST

config STM32N6_USB2_OTG_HS
	bool "USB2 OTG HS"
	default n
	select USBHOST_HAVE_ASYNCH if USBHOST

