# The start-up, "head", file.  Only common vectors are support so there
# isn't one.

HEAD_ASRC =

# Common ARM and Cortex-M55 files (ARMv8-M base)

include armv8-m/Make.defs

# Wrap __start so stm32_start.c can clear MSPLIM/PSPLIM (boot ROM
# sets stack limits that fault before __start's C prologue runs).

LDFLAGS += --wrap=__start

# Required STM32N6 files

CHIP_CSRCS += stm32_gpio.c stm32_irq.c stm32_lowputc.c stm32_rcc.c
CHIP_CSRCS += stm32_start.c stm32_pwr.c stm32_timerisr.c
CHIP_CSRCS += stm32_allocateheap.c

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CHIP_CSRCS += stm32_idle.c
endif

ifeq ($(CONFIG_STM32N6_USART),y)
CHIP_CSRCS += stm32_serial.c
endif

ifeq ($(CONFIG_STM32N6_SPI),y)
CHIP_CSRCS += stm32_spi.c
endif

ifeq ($(CONFIG_STM32N6_I2C),y)
CHIP_CSRCS += stm32_i2c.c
endif

ifeq ($(CONFIG_STM32N6_ADC),y)
CHIP_CSRCS += stm32_adc.c
endif

ifeq ($(CONFIG_STM32N6_DMA),y)
CHIP_CSRCS += stm32_dma.c
endif

ifeq ($(CONFIG_STM32N6_PWM),y)
CHIP_CSRCS += stm32_pwm.c
endif

ifeq ($(CONFIG_STM32N6_RTC),y)
CHIP_CSRCS += stm32_rtc.c
ifeq ($(CONFIG_RTC_DRIVER),y)
CHIP_CSRCS += stm32_rtc_lowerhalf.c
endif
endif

ifeq ($(filter y,$(CONFIG_STM32N6_IWDG) $(CONFIG_STM32N6_RTC_LSICLOCK)),y)
CHIP_CSRCS += stm32_lsi.c
endif

ifeq ($(CONFIG_STM32N6_IWDG),y)
CHIP_CSRCS += stm32_iwdg.c
endif

ifeq ($(CONFIG_STM32N6_RNG),y)
CHIP_CSRCS += stm32_rng.c
endif

ifeq ($(CONFIG_STM32N6_XSPI),y)
CHIP_CSRCS += stm32_xspi.c
endif

ifeq ($(CONFIG_ARM_MPU),y)
CHIP_CSRCS += stm32_mpuinit.c
endif

ifeq ($(CONFIG_USBDEV),y)
CHIP_CSRCS += stm32_otgdev.c
endif

ifeq ($(CONFIG_USBHOST),y)
CHIP_CSRCS += stm32_otghost.c
endif

ifeq ($(CONFIG_STM32N6_NPU),y)
CHIP_CSRCS += stm32_npu.c stm32_aton_hw.c stm32_npu_model.c

# ST LL_ATON runtime (hardware NPU register programming)
STEDGEAI := $(HOME)/STMicroelectronics/STEdgeAI3/3.0/Middlewares/ST/AI/Npu
CHIP_CSRCS += stm32_ll_aton.c stm32_ll_aton_util.c stm32_mcu_cache.c

# Include paths: compat layer first (provides stm32n6xx.h shim),
# then ST SDK headers
CFLAGS += -I$(TOPDIR)$(DELIM)..$(DELIM)npu$(DELIM)compat
CFLAGS += -I$(STEDGEAI)/ll_aton
CFLAGS += -I$(STEDGEAI)/Devices/STM32N6xx
CFLAGS += -I$(TOPDIR)$(DELIM)..$(DELIM)npu$(DELIM)model$(DELIM)generated
CFLAGS += -DCPU_IN_SECURE_STATE
CFLAGS += -DLL_ATON_PLATFORM=9 -DLL_ATON_OSAL=1 -DLL_ATON_RT_MODE=1
CFLAGS += -DLL_ATON_SW_FALLBACK=1

# SW fallback epoch support (DequantizeLinear, Resize, etc.)
STAICORE := $(HOME)/STMicroelectronics/STEdgeAI3/3.0/Middlewares/ST/AI
CHIP_CSRCS += stm32_ll_sw_integer.c stm32_ll_sw_float.c
CFLAGS += -I$(STAICORE)/Inc -I$(STAICORE)/Npu/ll_aton
EXTRA_LIBS += $(STAICORE)/Lib/GCC/ARMCortexM55/NetworkRuntime1100_CM55_GCC.a

endif

# Chip-specific RCC

CHIP_CSRCS += stm32n6xx_rcc.c
